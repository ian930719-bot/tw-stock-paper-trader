# Replace with your own listed/OTC symbols. Maximum 30 symbols.
# Format: SYMBOL:上市,SYMBOL:上櫃
PAPER_WATCHLIST=2330:上市,6488:上櫃

# Safety default: leave false until you have checked the paper account and watchlist.
# Set true to allow simulated BUY orders only. This never enables live brokerage orders.
PAPER_AUTO_ENTRIES=false

# Supported: atr_dynamic, oneil_growth, minervini_sepa
PAPER_EXIT_PROFILE=atr_dynamic
PAPER_ATR_MULTIPLE=2.0
PAPER_ETF_SYMBOLS=

# Optional FinMind token for historical data access.
FINMIND_TOKEN=

PAPER_WORKER_INTERVAL_SECONDS=30
